# URL de la Base de Datos (Supabase)
# Ejemplo: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="tu_url_de_supabase_aqui"

# Puerto del servidor (Render lo asigna automáticamente)
PORT=4000

# Secreto para JWT
JWT_SECRET="una_clave_secreta_muy_larga_y_segura"

# Configuración de CORS (URL de tu frontend en producción)
# Ejemplo: https://tu-pos.pages.dev
FRONTEND_URL="http://localhost:5173"
