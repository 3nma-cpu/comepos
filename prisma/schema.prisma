generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  protected   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  module String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([roleId, module])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  email     String   @unique
  roleId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role       @relation(fields: [roleId], references: [id])
  sales     Sale[]
  purchases Purchase[]
  cashRegistersOpened CashRegister[] @relation("CashRegisterOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashRegisterClosedBy")
}

enum EmployeeCategory {
  ADM
  CHOFER
}

model Client {
  id         String           @id @default(cuid())
  name       String
  cedula     String           @unique
  department String?
  position   String?
  category   EmployeeCategory
  email      String?
  phone      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  sales Sale[]
}

enum ProductCategory {
  PLATOS_PRINCIPALES
  BEBIDAS
  POSTRES
  ENTRADAS
  EXTRAS
}

enum ProductUnit {
  UNI
  KG
  LTS
}

model Product {
  id        String          @id @default(cuid())
  barcode   String?         @unique
  name      String
  category  ProductCategory
  unit      ProductUnit     @default(UNI)
  price     Float
  cost      Float
  stock     Float           @default(0)
  emoji     String          @default("plate")
  active    Boolean         @default(true)
  forResale Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
}

model Provider {
  id        String   @id @default(cuid())
  name      String
  ruc       String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  NOMINA
}

model Sale {
  id             String        @id @default(cuid())
  clientId       String
  userId         String
  cashRegisterId String?
  total          Int
  paymentMethod  PaymentMethod
  createdAt      DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  items        SaleItem[]
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id            String             @id @default(cuid())
  openedById    String
  closedById    String?
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  initialAmount Int                @default(0)
  finalAmount   Int?
  closingNotes  String?
  status        CashRegisterStatus @default(OPEN)

  openedBy User  @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])
  closedBy User? @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  sales    Sale[]
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  quantity  Float
  unitPrice Float
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum PurchasePaymentMethod {
  CONTADO
  CREDITO
}

model Purchase {
  id            String                @id @default(cuid())
  providerId    String
  userId        String
  total         Int
  paymentMethod PurchasePaymentMethod @default(CONTADO)
  dueDate       DateTime?
  noInvoice     Boolean               @default(false)
  timbrado      String?
  t1            String?
  t2            String?
  invoiceNumber String?
  createdAt     DateTime              @default(now())
  provider Provider       @relation(fields: [providerId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Float
  unitCost   Float
  forResale  Boolean  @default(true)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}
