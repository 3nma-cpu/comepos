generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  protected   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id     String @id @default(cuid())
  roleId String
  module String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([roleId, module])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  email     String   @unique
  roleId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role       @relation(fields: [roleId], references: [id])
  sales     Sale[]     @relation("SaleUser")
  cancelledSales Sale[] @relation("SaleCancelledBy")
  purchases Purchase[]
  cashRegistersOpened CashRegister[] @relation("CashRegisterOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashRegisterClosedBy")
}

enum EmployeeCategory {
  ADM
  CHOFER
}

model Client {
  id         String           @id @default(cuid())
  name       String
  cedula     String           @unique
  department String?
  position   String?
  category   EmployeeCategory
  email      String?
  phone      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  sales Sale[]
}

enum ProductCategory {
  PLATOS_PRINCIPALES
  BEBIDAS
  POSTRES
  ENTRADAS
  EXTRAS
}

enum ProductUnit {
  UNI
  KG
  LTS
}

model Product {
  id        String          @id @default(cuid())
  barcode   String?         @unique
  name      String
  category  ProductCategory
  unit      ProductUnit     @default(UNI)
  price     Float
  cost      Float
  stock     Float           @default(0)
  emoji     String          @default("plate")
  active    Boolean         @default(true)
  forResale Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
}

model Provider {
  id        String   @id @default(cuid())
  name      String
  ruc       String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  NOMINA
  TARJETA
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id                 String        @id @default(cuid())
  clientId           String
  userId             String
  cashRegisterId     String?
  total              Int
  paymentMethod      PaymentMethod
  status             SaleStatus    @default(COMPLETED)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  client             Client        @relation(fields: [clientId], references: [id])
  user               User          @relation("SaleUser", fields: [userId], references: [id])
  cancelledBy        User?         @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cashRegister       CashRegister? @relation(fields: [cashRegisterId], references: [id])
  items              SaleItem[]
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id            String             @id @default(cuid())
  openedById    String
  closedById    String?
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  initialAmount Int                @default(0)
  finalAmount   Int?
  closingNotes  String?
  status        CashRegisterStatus @default(OPEN)

  openedBy User  @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])
  closedBy User? @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  sales    Sale[]
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  quantity  Float
  unitPrice Float
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum PurchasePaymentMethod {
  CONTADO
  CREDITO
}

model Purchase {
  id            String                @id @default(cuid())
  providerId    String
  userId        String
  total         Int
  paymentMethod PurchasePaymentMethod @default(CONTADO)
  dueDate       DateTime?
  noInvoice     Boolean               @default(false)
  timbrado      String?
  t1            String?
  t2            String?
  invoiceNumber String?
  createdAt     DateTime              @default(now())
  provider Provider       @relation(fields: [providerId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  items    PurchaseItem[]
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Float
  unitCost   Float
  forResale  Boolean  @default(true)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

// ============================================
// Módulo: Pagos a Proveedores (independiente)
// ============================================

model ProveedorPago {
  id        String   @id @default(cuid())
  nombre    String
  ruc       String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pagos     PagoProveedor[]

  @@map("proveedores_pago")
}

model FormaPago {
  id     Int    @id @default(autoincrement())
  nombre String @unique
  pagos  PagoProveedor[]

  @@map("formas_pago")
}

model PagoProveedor {
  id           String        @id @default(cuid())
  proveedorId  String
  formaPagoId  Int
  mesPago      String        @db.VarChar(7)
  fechaPago    DateTime      @db.Date
  fechaCobro   DateTime?     @db.Date
  monto        Decimal       @db.Decimal(12, 2)
  observacion  String?
  createdAt    DateTime      @default(now())

  proveedor    ProveedorPago @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  formaPago    FormaPago     @relation(fields: [formaPagoId], references: [id])

  @@index([proveedorId, mesPago])
  @@index([mesPago])
  @@index([fechaPago])
  @@index([fechaCobro])
  @@map("pagos_proveedores")
}
